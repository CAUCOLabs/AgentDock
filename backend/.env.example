# AgentDock backend environment example

APP_NAME=AgentDock
APP_ENV=development
APP_DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Local workspace storage
WORKSPACES_DIR=./workspaces
LOGS_DIR=./logs
AGENTDOCK_DB_PATH=./data/agentdock.sqlite3

# GitHub integration
# For MVP, this can be a personal access token while we build the core flow.
# Later we will replace this with GitHub OAuth / GitHub App auth.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_DEFAULT_BRANCH=main

# AI provider
# Keep empty for now. We will add the agent integration later.
OPENAI_API_KEY=
AI_PROVIDER=mock
AGENT_RUNNER=mock
# Set AGENT_RUNNER=local and provide a command to run inside each task workspace.
# Example: LOCAL_RUNNER_COMMAND=npm test
LOCAL_RUNNER_COMMAND=
LOCAL_RUNNER_TIMEOUT_SECONDS=900

# Safety
ALLOW_PUSH=false
ALLOW_PR_CREATION=false
MAX_TASK_RUNTIME_SECONDS=900
