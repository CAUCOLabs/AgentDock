# AisoFlow backend environment example

APP_NAME=AisoFlow
APP_ENV=development
APP_DEBUG=true

# API
API_HOST=127.0.0.1
API_PORT=8000

# Local workspace storage
WORKSPACES_DIR=./workspaces
LOGS_DIR=./logs
AGENTDOCK_DB_PATH=./data/agentdock.sqlite3

# GitHub integration
# Optional fallback token for backend-only Git operations.
GITHUB_TOKEN=
GITHUB_OWNER=
GITHUB_DEFAULT_BRANCH=main
# GitHub App install flow for real product auth.
GITHUB_APP_ID=
GITHUB_APP_SLUG=
GITHUB_APP_PRIVATE_KEY=
# Or use GITHUB_APP_PRIVATE_KEY_PATH=...
GITHUB_APP_PRIVATE_KEY_PATH=
GITHUB_APP_CLIENT_ID=
GITHUB_APP_CLIENT_SECRET=
GITHUB_APP_INSTALL_URL=
# Configure this value as the GitHub App Setup URL, or as its Callback URL
# when "Request user authorization (OAuth) during installation" is enabled.
GITHUB_APP_CALLBACK_URL=http://127.0.0.1:8000/auth/github-app/callback
# Backend-to-mobile redirect after the GitHub callback completes.
# Expo Go local example: exp://192.168.0.100:8081/--/auth/github/callback
# Production build:
GITHUB_APP_MOBILE_CALLBACK_URL=aisoflow://auth/github/callback
GITHUB_PR_MERGE_METHOD=squash
DELETE_BRANCH_AFTER_MERGE=false
# Optional local-development OAuth fallback.
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=
GITHUB_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/auth/github/callback

# AI provider
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
PROMPT_ASSISTANT_OPENAI_MODEL=gpt-5.5
PROMPT_ASSISTANT_ANTHROPIC_MODEL=claude-sonnet-4-5
AI_PROVIDER=mock
AGENT_RUNNER=mock
# Codex CLI runtime. The backend/worker owns ChatGPT device auth and API key login.
CODEX_CLI_COMMAND=codex
CODEX_ENABLED=false
CODEX_TIMEOUT_SECONDS=900
# Set AGENT_RUNNER=local and provide a command to run inside each task workspace.
# Example: LOCAL_RUNNER_COMMAND=npm test
LOCAL_RUNNER_COMMAND=
LOCAL_RUNNER_TIMEOUT_SECONDS=900

# Safety
ALLOW_PUSH=false
ALLOW_PR_CREATION=false
MAX_TASK_RUNTIME_SECONDS=900
